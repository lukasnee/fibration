{
    "C_Cpp.autoAddFileAssociations": false,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "cmake.buildDirectory": "${workspaceFolder}/.build",
    "cmake.configureSettings": {
        "CMAKE_TOOLCHAIN_FILE": "arm-none-eabi-gcc.cmake",
    },
    "cmake.useCMakePresets": "always",
    "clangd.arguments": [
        "--compile-commands-dir=.build/higgs-dbg",
        "--query-driver=**",
        "--background-index",
        "--clang-tidy"
    ],
    "clangd.enable": true,
    "psi-header.templates": [
        {
            "language": "c",
            "template": [
                "Copyright (c) <<year>> <<author>> <<<authoremail>>>",
                "SPDX-License-Identifier: GPL-2.0-only",
            ]
        },
        {
            "language": "cpp",
            "template": [
                "Copyright (c) <<year>> <<author>> <<<authoremail>>>",
                "SPDX-License-Identifier: GPL-2.0-only"
            ]
        },
        {
            "language": "python",
            "template": [
                "Copyright (c) <<year>> <<author>> <<<authoremail>>>",
                "SPDX-License-Identifier: GPL-2.0-only"
            ]
        },
    ],
    "psi-header.lang-config": [
        {
            "language": "c",
            "begin": "",
            "prefix": "// ",
            "end": "",
            "blankLinesAfter": 1
        },
        {
            "language": "cpp",
            "begin": "",
            "prefix": "// ",
            "end": "",
            "blankLinesAfter": 1
        },
        {
            "language": "python",
            "begin": "",
            "prefix": "# ",
            "end": "",
            "blankLinesAfter": 1
        },
    ],
    "psi-header.changes-tracking": {
        "autoHeader": "autoSave",
        "include": [
            "c",
            "cpp",
            "python"
        ],
    },
}
